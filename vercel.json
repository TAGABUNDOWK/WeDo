{
  "version": 2,
  "builds": [
    {
      "src": "api/generate-otp.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/verify-otp.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/generate-otp",
      "dest": "api/generate-otp.js"
    },
    {
      "src": "/verify-otp",
      "dest": "api/verify-otp.js"
    }
  ]
}
