rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isFriendParticipant() {
      return isSignedIn() && request.auth.uid in resource.data.userIds;
    }

    function isGroupMember(groupId) {
      return isSignedIn()
        && request.auth.uid in get(/databases/$(database)/documents/group_chats/$(groupId)).data.members;
    }

    function isDirectChatParticipant(chatId) {
      return isSignedIn()
        && request.auth.uid in get(/databases/$(database)/documents/direct_chats/$(chatId)).data.members;
    }

    function isSessionHost(sessionId) {
      return isSignedIn()
        && request.auth.uid == get(/databases/$(database)/documents/sessions/$(sessionId)).data.hostId;
    }

    function isSessionParticipant(sessionId) {
      return isSignedIn()
        && (request.auth.uid == get(/databases/$(database)/documents/sessions/$(sessionId)).data.hostId
            || exists(/databases/$(database)/documents/sessions/$(sessionId)/participants/$(request.auth.uid)));
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update, delete: if isSignedIn() && request.auth.uid == userId;

      match /notifications/{notificationId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow create: if isSignedIn();
        allow update: if isSignedIn() && request.auth.uid == userId;
        allow delete: if isSignedIn() && request.auth.uid == userId;
      }
    }

    match /friends/{friendshipId} {
      allow create: if isSignedIn()
        && request.resource.data.userIds is list
        && request.resource.data.userIds.size() == 2
        && request.resource.data.userIds.hasAll([request.auth.uid])
        && request.resource.data.status == 'pending'
        && request.resource.data.requestedBy == request.auth.uid;
      allow read: if isFriendParticipant();
      allow update: if isFriendParticipant()
        && request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['status', 'updatedAt']);
      allow delete: if isFriendParticipant();
    }

    match /group_chats/{groupId} {
      allow read: if isSignedIn()
        && request.auth.uid in resource.data.members;
      allow create: if isSignedIn()
        && request.resource.data.members is list
        && request.resource.data.members.hasAny([request.auth.uid])
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if isSignedIn()
        && request.auth.uid in resource.data.members;
      allow delete: if isSignedIn()
        && resource.data.createdBy == request.auth.uid;

      match /members/{memberUid} {
        allow read: if isGroupMember(groupId);
        allow create: if isSignedIn() && (request.auth.uid == memberUid || isGroupMember(groupId));
        allow update, delete: if isSignedIn() && (request.auth.uid == memberUid || isGroupMember(groupId));
      }

      match /messages/{messageId} {
        allow read: if isGroupMember(groupId);
        allow create: if isGroupMember(groupId)
          && (request.resource.data.senderId == request.auth.uid
              || request.resource.data.sender_id == request.auth.uid
              || request.resource.data.senderId == 'system'
              || request.resource.data.sender_id == 'system');
        allow update, delete: if isGroupMember(groupId);
      }
    }

    match /direct_chats/{chatId} {
      allow read: if isSignedIn()
        && request.auth.uid in resource.data.members;
      allow create: if isSignedIn()
        && request.resource.data.members is list
        && request.resource.data.members.hasAny([request.auth.uid]);
      allow update: if isSignedIn()
        && request.auth.uid in resource.data.members;

      match /messages/{messageId} {
        allow read: if isDirectChatParticipant(chatId);
        allow create: if isDirectChatParticipant(chatId)
          && (request.resource.data.senderId == request.auth.uid
              || request.resource.data.sender_id == request.auth.uid);
        allow update, delete: if isDirectChatParticipant(chatId);
      }
    }

    match /topics/{topicId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn();

      match /cards/{cardId} {
        allow read: if true;
        allow create: if isSignedIn();
        allow update, delete: if isSignedIn();
      }
    }

    match /sessions/{sessionId} {
      allow read: if isSignedIn() && isSessionParticipant(sessionId);
      allow create: if isSignedIn()
        && request.resource.data.hostId == request.auth.uid
        && request.resource.data.sessionId == sessionId;
      allow update: if isSignedIn() && isSessionParticipant(sessionId);
      allow delete: if isSignedIn() && isSessionHost(sessionId);

      match /participants/{userId} {
        allow read: if isSignedIn() && isSessionParticipant(sessionId);
        allow create: if isSignedIn() && request.auth.uid == userId;
        allow update: if isSignedIn() && request.auth.uid == userId;
        allow delete: if isSignedIn() && isSessionHost(sessionId);
      }
    }
  }
}
